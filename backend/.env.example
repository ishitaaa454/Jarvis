APP_NAME=Jarvis Workspace
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8765
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

# Phase 2 — offline wake-phrase detection (Vosk + sounddevice)
VOICE_ENABLED=true
VOICE_START_AUTOMATICALLY=true
WAKE_PHRASE=Wake up Jarvis
VOSK_MODEL_PATH=models/vosk-model-small-en-us
VOICE_DEVICE_ID=
VOICE_DEVICE_NAME=
VOICE_SAMPLE_RATE=16000
VOICE_BLOCK_SIZE=4000
VOICE_AUDIO_QUEUE_SIZE=50
WAKE_CONFIDENCE_THRESHOLD=0.65
WAKE_COOLDOWN_SECONDS=4
VOICE_DEBUG_TRANSCRIPTS=false

# Phase 3 — offline British male TTS (Piper)
TTS_ENABLED=true
TTS_START_AUTOMATICALLY=true
PIPER_EXECUTABLE_PATH=
PIPER_VOICE_MODEL_PATH=voices/en_GB-alan-medium/en_GB-alan-medium.onnx
PIPER_VOICE_CONFIG_PATH=voices/en_GB-alan-medium/en_GB-alan-medium.onnx.json
TTS_OUTPUT_DEVICE_ID=
TTS_OUTPUT_DEVICE_NAME=
TTS_VOLUME=0.90
TTS_LENGTH_SCALE=1.08
TTS_NOISE_SCALE=0.667
TTS_NOISE_WIDTH=0.80
WELCOME_LINE_1=Welcome back, Ishita. Initializing your workspace.
WELCOME_LINE_2=All systems are online.
WELCOME_LINE_3=Opening your workspace now.
WELCOME_SENTENCE_PAUSE_MS=700
TTS_PRE_SPEECH_DELAY_MS=200
TTS_POST_SPEECH_DELAY_MS=700
TTS_SYNTHESIS_TIMEOUT_SECONDS=30
TTS_QUEUE_SIZE=5
TTS_TEMP_DIRECTORY=
TTS_DELETE_TEMP_AUDIO=true

# Phase 4 — Windows workspace launching
WORKSPACE_ENABLED=true
WORKSPACE_START_AFTER_WELCOME=true
WORKSPACE_CONFIG_PATH=config/applications.json
WORKSPACE_DEFAULT_PROFILE=default
WORKSPACE_INTER_APP_DELAY_MS=600
WORKSPACE_READY_DISPLAY_MS=1500
WORKSPACE_APPLICATION_START_TIMEOUT_SECONDS=15
WORKSPACE_WINDOW_DISCOVERY_TIMEOUT_SECONDS=8
WORKSPACE_WINDOW_POLL_INTERVAL_MS=300
WORKSPACE_FOCUS_EXISTING=true
WORKSPACE_ALLOW_URL_LAUNCH=true
WORKSPACE_ALLOW_URI_LAUNCH=true
WORKSPACE_ALLOW_START_APP_LAUNCH=true
WORKSPACE_CONTINUE_ON_APPLICATION_ERROR=true
WORKSPACE_DEBUG_WINDOW_DISCOVERY=false
WORKSPACE_MANUAL_START_IN_PRODUCTION=false
CHROME_EXECUTABLE_PATH=
VSCODE_EXECUTABLE_PATH=
TEAMS_EXECUTABLE_PATH=
WHATSAPP_EXECUTABLE_PATH=
SPOTIFY_EXECUTABLE_PATH=
GMAIL_URL=https://mail.google.com/
NEWS_URL=https://news.google.com/

# Phase 6 — advanced local system monitoring
SYSTEM_MONITOR_ENABLED=true
SYSTEM_MONITOR_START_AUTOMATICALLY=true
SYSTEM_FAST_SAMPLE_INTERVAL_SECONDS=1
SYSTEM_PROCESS_SAMPLE_INTERVAL_SECONDS=5
SYSTEM_STATIC_REFRESH_INTERVAL_SECONDS=60
SYSTEM_OPTIONAL_HARDWARE_INTERVAL_SECONDS=2
SYSTEM_HISTORY_MAX_SAMPLES=300
SYSTEM_HISTORY_MAX_API_POINTS=300
SYSTEM_PROVIDER_TIMEOUT_SECONDS=3
SYSTEM_PROCESS_TIMEOUT_SECONDS=15
SYSTEM_PROCESS_LIMIT=100
SYSTEM_PROCESS_DEFAULT_SORT=cpu
SYSTEM_PROCESS_INCLUDE_START_TIME=true
SYSTEM_INCLUDE_NETWORK_ADAPTERS=true
SYSTEM_INCLUDE_DISCONNECTED_ADAPTERS=false
SYSTEM_INCLUDE_LOOPBACK_ADAPTERS=false
SYSTEM_INCLUDE_VIRTUAL_ADAPTERS=true
SYSTEM_SHOW_IP_ADDRESSES=false
SYSTEM_INCLUDE_NETWORK_DRIVES=false
SYSTEM_INCLUDE_REMOVABLE_DRIVES=false
SYSTEM_SHOW_HOSTNAME=true
GPU_MONITOR_ENABLED=true
NVIDIA_NVML_ENABLED=true
TEMPERATURE_MONITOR_ENABLED=true
LIBRE_HARDWARE_MONITOR_ENABLED=false
LIBRE_HARDWARE_MONITOR_PATH=
SYSTEM_WEBSOCKET_METRICS_ENABLED=true
SYSTEM_WEBSOCKET_PROCESS_EVENTS_ENABLED=true
